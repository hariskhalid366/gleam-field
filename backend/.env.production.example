# Copy to .env on the server. Never commit this file after adding real values.
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1

# Use a managed MongoDB connection. URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/servicepro?retryWrites=true&w=majority

# Generate each separately: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-unique-64-character-hex-secret
JWT_REFRESH_SECRET=replace-with-a-different-unique-64-character-hex-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated, exact HTTPS frontend origins. No trailing slash.
CORS_ORIGINS=https://app.example.com

BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
LOG_LEVEL=info

# Optional AI reporting integration.
GEMINI_API_KEY=
GEMINI_REPORT_MODEL=gemini-2.0-flash
