# ─── Runtime ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ─── Database ───────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/servicepro

# ─── JWT (use long random values, never commit real secrets) ─
JWT_ACCESS_SECRET=replace-with-64-char-random-string
JWT_REFRESH_SECRET=replace-with-a-different-64-char-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Security ───────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=info
